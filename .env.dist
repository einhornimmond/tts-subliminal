# Template: copy to .env and uncomment lines as needed.
# All values shown here are the built-in defaults.

# Folder that holds the TTS model. If it contains none, the program offers a download.
#MODEL_PATH=models

# cpu or cuda. cuda needs a build with `--features cuda` (see README);
# such a build uses cuda by default.
#PROVIDER=cpu

# Voice level in dB relative to full scale. Lower = more hidden.
#VOICE_DB=-30

# sleep (6 h), work, meditate or active (30 min each); sets length and beat frequency
#MODE=sleep

# Speaking rate of the voice; 1 = normal
#SPEED=2

# Copies of the voice stacked on top of each other; 1 = no layering
#LAYERS=3

# Speaker id for multi-voice models (Kokoro: 0-10)
#SPEAKER=0
